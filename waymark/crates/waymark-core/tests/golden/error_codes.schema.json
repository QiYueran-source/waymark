  "type": "string",
  "enum": [
    "ITEM_NOT_FOUND",
    "CATEGORY_NOT_FOUND",
    "VALIDATION_ERROR",
    "INVALID_ID",
    "PARSE_ERROR",
    "CONFIG_INVALID",
    "DUPLICATE_ID",
    "ID_PATH_MISMATCH",
    "CYCLE_DETECTED",
    "INVALID_RELATIONSHIP",
    "INCOMPLETE_PROJECTION",
    "WEB_NOT_INCLUDED",
    "WRITE_CONFLICT",
    "ITEM_ARCHIVED",
    "ALREADY_ARCHIVED",
    "HAS_ACTIVE_CHILDREN",
    "PROJECT_NOT_FOUND",
    "IO_ERROR",
    "GIT_ERROR",
    "GIT_UNAVAILABLE",
    "LOCK_TIMEOUT",
    "LOCK_FAILED",
    "SNAPSHOT_UNSTABLE",
    "PORT_IN_USE",
    "UNSUPPORTED_VERSION",
    "ITEM_NEEDS_MIGRATION",
    "ACTION_REQUIRES_MIGRATION",
    "MIGRATION_PATH_CONFLICT",
    "MIGRATION_UNSUPPORTED_GENERATION",
    "MIGRATION_PRECONDITION_FAILED",
    "MIGRATION_FAILED",
    "ROLLBACK_FAILED",
    "ID_GENERATION_FAILED",
    "INTERNAL_ERROR",
    "OWNER_MISMATCH",
    "LOCK_HELD",
    "MIGRATION_AVAILABLE",
    "NOT_A_GIT_REPOSITORY",
    "DANGLING_REFERENCE",
    "TIMESTAMP_INCOHERENT",
    "ASSETS_VERSION_MISMATCH",
    "TIME_ZONE_UNDETECTED",
    "CLOSED_PARENT",
    "ONE_SIDED_SOFT_LINK",
    "CASCADE_CONSENT_REQUIRED",
    "OWNED_BY_OTHER"
  ]
}
